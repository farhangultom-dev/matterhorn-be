meta {
  name: Get Health
  type: http
  seq: 1
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

docs {
  Verifies that the HTTP service is running and PostgreSQL is reachable.

  Success response: 200 with `data.status` set to `ok` and `data.database` set to `up`.
  Failure response: 503 `SERVICE_UNAVAILABLE` when the database cannot be reached.
}
