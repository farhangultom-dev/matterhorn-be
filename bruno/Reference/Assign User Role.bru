meta {
  name: Assign User Role
  type: http
  seq: 4
  tags: [
    reference
    user-roles
  ]
}

post {
  url: {{baseUrl}}/api/v1/user-roles
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "userId": "e63cd4bd-c5c1-4446-8932-9ec744bb6030",
    "roleId": 1
  }
}

docs {
  Assigns an active role to an active user. This endpoint requires a verified account with the admin role. Use Get Roles to find roleId and the user UUID from the user record.
  
  Success response: 201 with data.userRole containing id, userId, roleId, and createdAt.
  Errors include 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 USER_NOT_FOUND or ROLE_NOT_FOUND, and 409 USER_ROLE_ALREADY_EXISTS.
}
