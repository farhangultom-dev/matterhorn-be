}

get {
  url: {{baseUrl}}/api/v1/roles
  body: none
  auth: none
}

docs {
  Returns all active roles ordered alphabetically by name. Soft-deleted roles are excluded.

  Success response: 200 with data.roles containing id, name, and createdAt.
}
