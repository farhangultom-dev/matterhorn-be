meta {
  name: Update Community
  type: http
  seq: 4
  tags: [
    communities
    auth
  ]
}

patch {
  url: {{baseUrl}}/api/v1/communities/{{communityId}}
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "description": "Updated from Bruno",
    "status": "active"
  }
}

docs {
  Requires the community owner or an admin Bearer token. Omitted fields remain unchanged and nullable fields can be cleared with null. Owners cannot set or modify suspended communities.

  Errors include 400 VALIDATION_ERROR or INVALID_CITY, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 COMMUNITY_NOT_FOUND, and 409 COMMUNITY_SLUG_EXISTS.
}
