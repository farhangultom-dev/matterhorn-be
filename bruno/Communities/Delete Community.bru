meta {
  name: Delete Community
  type: http
  seq: 5
  tags: [
    communities
    auth
  ]
}

delete {
  url: {{baseUrl}}/api/v1/communities/{{communityId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft-deletes the community. Requires the community owner or an admin Bearer token. The database row and related rows are not hard-deleted.

  Success response: 200 with data.deleted=true. Errors include 401 UNAUTHORIZED, 403 FORBIDDEN, and 404 COMMUNITY_NOT_FOUND.
}
