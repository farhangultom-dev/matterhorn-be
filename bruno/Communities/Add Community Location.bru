meta {
  name: Add Community Location
  type: http
  seq: 9
  tags: [
    communities
  ]
}

post {
  url: {{baseUrl}}/api/v1/communities/{{communityId}}/locations
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "cityId": 1,
    "urlGmapsLocations": "https://maps.google.com/?q=Matterhorn",
    "isPrimary": false
  }
}

docs {
  Adds a location to the community. At least one of cityId or urlGmapsLocations is required. Use an active city ID returned by the province/city reference endpoints. Only one active primary location is allowed for a community.
  
  Success response: 201 with data.communityLocation containing id, communityId, cityId, urlGmapsLocations, isPrimary, and createdAt.
  Errors include 400 VALIDATION_ERROR or INVALID_CITY, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 COMMUNITY_NOT_FOUND, and 409 COMMUNITY_PRIMARY_LOCATION_ALREADY_EXISTS.
}
