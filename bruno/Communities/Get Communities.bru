meta {
  name: Get Communities
  type: http
  seq: 1
  tags: [
    communities
    public
  ]
}

get {
  url: {{baseUrl}}/api/v1/communities?page=1&limit=20
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  @description('optional dont send if not use')
  ~search: matt
  @description('optional dont send if not use')
  ~cityId: 1
  @description('optional dont send if not use')
  ~disciplineSportId: 1
}

docs {
  Returns active public communities with pagination. Optional query parameters are page, limit, search (matches
  community name and slug), cityId, and disciplineSportId. Results are ordered by newest createdAt first.
  
  Success response: 200 with data.communities and data.pagination. Each community includes active disciplineSports, locations, schedules, and socialLinks arrays. Unknown query parameters or invalid values return 400 VALIDATION_ERROR.
}
