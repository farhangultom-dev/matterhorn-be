meta {
  name: Add Community Schedule
  type: http
  seq: 10
  tags: [
    communities
  ]
}

post {
  url: {{baseUrl}}/api/v1/communities/{{communityId}}/schedules
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dayOfWeek": 1,
    "startTime": "06:00",
    "endTime": "08:00",
    "locationId": 1
  }
}

docs {
  Adds a schedule to the community. dayOfWeek uses 1 for Monday through 7 for Sunday. Times accept HH:mm or HH:mm:ss and endTime must be later than startTime. Use a locationId from an active location belonging to this community, or omit it for a schedule without a linked location.

  Success response: 201 with data.communitySchedule containing id, communityId, dayOfWeek, startTime, endTime, locationId, and createdAt.
  Errors include 400 VALIDATION_ERROR or INVALID_LOCATION, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 COMMUNITY_NOT_FOUND, and 409 COMMUNITY_SCHEDULE_ALREADY_EXISTS.
}
