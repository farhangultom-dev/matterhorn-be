meta {
  name: Add Community Discipline Sport
  type: http
  seq: 8
  tags: [
    communities
  ]
}

post {
  url: {{baseUrl}}/api/v1/communities/{{communityId}}/discipline-sports
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "disciplineSportId": 3
  }
}

docs {
  Adds an active discipline sport to the community. The caller must own the community or have the active admin role. Use Get Discipline Sports to select disciplineSportId and the communityId environment variable for the target community.
  
  Success response: 201 with data.communityDisciplineSport containing id, communityId, disciplineSportId, disciplineSportName, and createdAt.
  Errors include 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 COMMUNITY_NOT_FOUND or DISCIPLINE_SPORT_NOT_FOUND, and 409 COMMUNITY_DISCIPLINE_SPORT_ALREADY_EXISTS.
}
