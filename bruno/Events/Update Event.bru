meta {
  name: Update Event
  type: http
  seq: 4
  tags: [
    events
    auth
  ]
}

patch {
  url: {{baseUrl}}/api/v1/events/{{eventId}}
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "description": "Updated from Bruno",
    "capacity": 120
  }
}

docs {
  Updates only supplied fields. Nullable fields may be cleared with null. The stored event values are merged before validating both time ranges. Requires active role ID 1 or 4. Errors include 400 VALIDATION_ERROR, INVALID_ORGANIZER, or INVALID_CITY, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 EVENT_NOT_FOUND, and 409 EVENT_SLUG_EXISTS.
}
