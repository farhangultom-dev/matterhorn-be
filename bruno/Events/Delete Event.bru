meta {
  name: Delete Event
  type: http
  seq: 5
  tags: [
    events
    auth
  ]
}

delete {
  url: {{baseUrl}}/api/v1/events/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft-deletes the event and preserves participants, tickets, orders, and payments. Requires active role ID 1 or 4. Repeating the request returns 404 EVENT_NOT_FOUND.
}
