meta {
  name: Create Event
  type: http
  seq: 3
  tags: [
    events
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  posterUrl: @file(./fixtures/event-poster.png) @contentType(image/png)
  data: {"organizerId":"{{organizerId}}","title":"Matterhorn Running Meetup","slug":"matterhorn-running-meetup-2027","description":"Community running meetup","eventType":"meetup","visibility":"public","startsAt":"2027-03-14T08:00:00+07:00","endsAt":"2027-03-14T11:00:00+07:00","venueName":"City Park","venueAddress":"Bandar Lampung","venueGmapsUrl":"https://maps.google.com/?q=City+Park","cityId":1,"capacity":100,"registrationOpenAt":"2027-02-01T00:00:00+07:00","registrationCloseAt":"2027-03-13T23:59:00+07:00","disciplineSports":[1],"ticketTypes":[{"name":"Regular","price":100000,"quota":100,"salesStartAt":"2027-02-01T00:00:00+07:00","salesEndAt":"2027-03-13T23:59:00+07:00"}]}
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar('eventId', res.getBody().data.event.id);
  }
}

docs {
  Requires a verified account with active numeric role ID 1 or 4 and an active organizerId. Send event fields as the JSON data part and select a JPEG, PNG, or WebP file in posterUrl (maximum 5 MiB). Place a local image at bruno/fixtures/event-poster.png or edit the relative path. Omit posterUrl to create an event without a poster. Timestamps must include a timezone offset. `disciplineSports` accepts active discipline sport IDs, and `ticketTypes` accepts name, price, quota, salesStartAt, and salesEndAt. Do not put posterUrl inside data. Use a unique slug for repeated runs. Errors include 400 VALIDATION_ERROR, INVALID_UPLOAD, INVALID_ORGANIZER, INVALID_CITY, INVALID_DISCIPLINE_SPORT, 401 UNAUTHORIZED, 403 FORBIDDEN, 413 FILE_TOO_LARGE, 415 UNSUPPORTED_IMAGE_TYPE, and 503 STORAGE_UNAVAILABLE.
}
