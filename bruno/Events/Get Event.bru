meta {
  name: Get Event
  type: http
  seq: 2
  tags: [
    events
    public
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{eventId}}
  body: none
  auth: none
}

docs {
  Returns one public event using eventId captured by Create Event, including event_discipline_sports rows whose linked discipline sport is active as disciplineSports and its event_ticket_types rows as ticketTypes. Private, deleted, or unknown events return 404 EVENT_NOT_FOUND.
}
