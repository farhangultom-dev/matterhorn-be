meta {
  name: Login
  type: http
  seq: 4
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "farhangultomdev@gmail.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar('accessToken', res.getBody().data.accessToken);
  }
}

docs {
  Authenticates the account identified by `registrationEmail` and stores the response access token in Bruno's runtime `accessToken` variable.
  
  Run this request before `Get Current User`. The runtime token is not persisted to `environments/Local.bru`; run Login again after the token expires.
  
  Success response: 200 with `accessToken`, `tokenType` set to `Bearer`, and `expiresIn` in seconds.
  Error responses: 400 `VALIDATION_ERROR`, 401 `INVALID_CREDENTIALS`, or 403 `EMAIL_NOT_VERIFIED`.
}
