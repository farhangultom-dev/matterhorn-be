meta {
  name: Resend Verification OTP
  type: http
  seq: 3
  tags: [
    auth
    verification
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/resend-verification-otp
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "farhangultomdev@gmail.com"
  }
}

docs {
  Sends a new code for a pending account. Unknown, soft-deleted, and already verified emails receive the same generic 200 response without an email. Requests are limited to one per 60 seconds and five sends per hour.
  
  Errors include 400 VALIDATION_ERROR, 429 OTP_RESEND_LIMITED, and 503 EMAIL_DELIVERY_UNAVAILABLE.
}
