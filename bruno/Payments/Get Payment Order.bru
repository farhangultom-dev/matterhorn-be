meta {
  name: Get Payment Order
  type: http
  seq: 2
  tags: [
    payments
    auth
  ]
}

get {
  url: {{baseUrl}}/api/v1/payments/orders/093ed9d1-3ae5-417a-a186-4841e699122f
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns the local order, item price snapshots, and latest payment attempt for the authenticated owner. Payment status pending is not proof of payment. Another user's order returns 404 ORDER_NOT_FOUND.
}
