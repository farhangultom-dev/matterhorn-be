NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=matterhorn_dev
DB_USER=matterhorn_app
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
BCRYPT_SALT_ROUNDS=12
SEED_DEMO_PASSWORD=

# Set SMTP_ENABLED=true before accepting new registrations; registration sends an OTP email.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3-compatible public storage for profile photos, community media, organizer logos, and event posters. PROFILE_PHOTO_PUBLIC_BASE_URL is required when storage is configured.
# Community media uses community-media/<communityId>/<logo|cover>/, organizer logos use organizer-media/<organizerId>/logo/, and event posters use event-media/<eventId>/poster/ in this same bucket.
AWS_REGION=
S3_PROFILE_PHOTO_BUCKET=
PROFILE_PHOTO_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# SumoPod payment initiation. Production rejects the sandbox unless the temporary explicit opt-in below is true.
# Do not expose SUMOPOD_API_KEY to Bruno or frontend clients.
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_ALLOW_SANDBOX_IN_PRODUCTION=false
SUMOPOD_API_KEY=
SUMOPOD_SUCCESS_RETURN_URL=https://example.com/payment/success
SUMOPOD_CANCEL_RETURN_URL=https://example.com/payment/cancel
SUMOPOD_WEBHOOK_TOKEN=
